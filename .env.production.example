# Production configuration. Copy to .env.production and fill in.
#
# The app refuses to start with ENV=production unless JWT_SECRET has been changed,
# COOKIE_SECURE is true, and every CORS origin is https. That check runs in Settings,
# so it covers the API, the worker and alembic alike.

# ---- Domains (used by Caddy for automatic TLS) ----
DOMAIN=clearclause.example.com
API_DOMAIN=api.clearclause.example.com

# ---- Postgres ----
POSTGRES_USER=clearclause
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=clearclause
DATABASE_URL=postgresql+asyncpg://clearclause:<same password>@db:5432/clearclause

REDIS_URL=redis://redis:6379/0

# ---- Secrets ----
JWT_SECRET=                   # generate: openssl rand -hex 32   (rotating this logs everyone out)
METRICS_TOKEN=                # generate: openssl rand -hex 16   (guards /internal/metrics)

# ---- Deployment ----
ENV=production
COOKIE_SECURE=true            # required in production; the app will not start otherwise
TRUSTED_PROXY_DEPTH=1         # exactly one hop: Caddy. Wrong value breaks rate limiting.
CORS_ORIGINS=https://clearclause.example.com
PUBLIC_APP_URL=https://clearclause.example.com  # reset links; must be https in production

# ---- Transactional email (required: password reset depends on it) ----
# Any SMTP provider — Resend, SES, Postmark, Mailgun. The app will not start without a host.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClearClause <noreply@clearclause.example.com>

# ---- Storage: object storage, encrypted at rest ----
STORAGE_BACKEND=s3
S3_BUCKET=clearclause-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=              # blank for AWS; set for R2 / Spaces / MinIO
AWS_ACCESS_KEY_ID=            # an IAM user scoped to this bucket only
AWS_SECRET_ACCESS_KEY=

# ---- App ----
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
FILE_RETENTION_DAYS=7         # documents are deleted after this many days
MONTHLY_UPLOAD_LIMIT=20       # documents per account per month; 0 disables the cap.
                              # OCR is CPU-bound, so this is the ceiling on what one
                              # account can cost you.
OCR_PROVIDER=auto
WORKER_CONCURRENCY=2          # OCR is CPU-bound: keep at or below core count

NEXT_PUBLIC_API_BASE_URL=https://api.clearclause.example.com

# ---- AI / RAG (optional; off keeps the deterministic pipeline fully working) ----
# full = Q&A + summary (needs Qdrant: bring the stack up with --profile ai)
# summary_only = AI summary, no Qdrant needed
AI_MODE=off                   # off | summary_only | full
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=                 # required unless AI_MODE=off
JINA_API_KEY=                 # required unless AI_MODE=off (embeddings)
QDRANT_URL=http://qdrant:6333 # only used when AI_MODE=full

# ---- Observability ----
# Error reporting. Blank disables it entirely — and with it, any chance of hearing
# about an exception you did not already write an alert rule for. Set this.
SENTRY_DSN=

OTEL_EXPORTER_OTLP_ENDPOINT=
