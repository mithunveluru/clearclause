# Local development (docker compose). For hosted deploys see docs/DEPLOYMENT.md —
# on Render/Vercel these are set in each dashboard, not in a file.

# ---- Postgres (consumed by the db container + backend) ----
POSTGRES_USER=clearclause
POSTGRES_PASSWORD=clearclause
POSTGRES_DB=clearclause

# ---- Backend ----
# A managed postgres:// URL is upgraded to +asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://clearclause:clearclause@db:5432/clearclause
REDIS_URL=redis://redis:6379/0          # Celery broker, rate limits, token revocation
JWT_SECRET=change-me-in-prod            # token signing key; must be changed in production
OCR_PROVIDER=auto                       # auto = PDF text layer first, OCR only scanned pages
                                        # tesseract = force OCR on every page
OCR_LOW_CONFIDENCE=60                   # warn the user below this mean confidence (0-100)
MAX_UPLOAD_MB=10                        # per-file size cap
MAX_PDF_PAGES=50                        # OCR memory scales with pages, not file size
FILE_RETENTION_DAYS=7                   # daily sweep deletes documents older than this
MONTHLY_UPLOAD_LIMIT=20                 # documents per account per month; 0 disables the cap
SENTRY_DSN=                             # error reporting; blank disables it
OTEL_EXPORTER_OTLP_ENDPOINT=            # blank = telemetry is a no-op

# ---- Origins & cookies ----
CORS_ORIGINS=http://localhost:3000      # comma-separated allowed origins
PUBLIC_APP_URL=http://localhost:3000    # password reset links are built against this

# Transactional email (password reset). Blank host logs the message instead of
# sending it, which is what local development wants. Production requires a host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClearClause <noreply@localhost>
CORS_ORIGIN_REGEX=                      # e.g. ^https://clearclause-.*\.vercel\.app$ for previews
COOKIE_SAMESITE=lax                     # lax = same site; none = frontend on another domain
                                        # (Vercel + Render). none requires COOKIE_SECURE=true
                                        # and activates the CSRF double-submit guard.

# ---- Storage ----
# local = a plain directory (dev only: unencrypted, and lost on every redeploy).
# s3    = S3/R2/Spaces, encrypted at rest, reports served by signed URL.
# Any host without a persistent disk (Render free) must use s3.
STORAGE_BACKEND=local                   # local | s3
STORAGE_DIR=/storage                    # local backend root
S3_BUCKET=
S3_ENDPOINT_URL=                        # set for R2 / Spaces / MinIO; blank for AWS
S3_REGION=
# Read by boto3 from the environment, required when STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Deployment ----
# With ENV=production the app refuses to start unless JWT_SECRET is changed,
# COOKIE_SECURE=true, and every CORS origin is https.
ENV=development                         # development | production
COOKIE_SECURE=false                     # true over HTTPS — auth cookies need the Secure flag
TRUSTED_PROXY_DEPTH=0                   # 0 = direct. Behind a proxy/LB set the number of hops,
                                        # or every request looks like it came from the LB and
                                        # one user rate-limits everyone. Render/Vercel: 1.
METRICS_TOKEN=                          # non-empty enables /internal/metrics behind a token

# ---- Classification routing ----
CLASSIFICATION_AUTO_THRESHOLD=0.90      # at/above this, classification proceeds automatically
CLASSIFICATION_CONFIRM_THRESHOLD=0.70   # at/above this, alternatives are offered; below, manual

# ---- AI / RAG (optional; AI_MODE=off keeps everything else working) ----
# Vector store runs with: docker compose --profile ai up
AI_MODE=off                             # off | summary_only | full
AI_MODEL=llama-3.3-70b-versatile        # Groq model id
GROQ_API_KEY=                           # required unless AI_MODE=off (LLM)
JINA_API_KEY=                           # required unless AI_MODE=off (embeddings)
QDRANT_URL=http://qdrant:6333           # only used when AI_MODE=full

# ---- Frontend (Vercel: set in the project's env settings) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Grafana / Observability (infra/docker-compose.obs.yml) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me         # required; the stack refuses to start unset
