# ---- Postgres (consumed by db container + backend) ----
POSTGRES_USER=clearclause
POSTGRES_PASSWORD=clearclause
POSTGRES_DB=clearclause

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://clearclause:clearclause@db:5432/clearclause
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-prod
OCR_PROVIDER=auto              # auto = read the PDF text layer, OCR only scanned pages
                               # tesseract = force OCR on every page
OTEL_EXPORTER_OTLP_ENDPOINT=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50               # OCR memory scales with page count, not file size
FILE_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:3000

# ---- Storage ----
# local = a plain directory (dev/tests only: unencrypted, unbacked, lost on redeploy).
# s3    = S3/R2/Spaces, encrypted at rest, reports served by signed URL.
# Anything holding real user documents belongs on s3.
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=/storage           # local backend root
S3_BUCKET=
S3_ENDPOINT_URL=               # set for R2 / Spaces / MinIO; blank for AWS
S3_REGION=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read from the environment by boto3.

# ---- Deployment ----
# These default to the *insecure* dev values. With ENV=production the app refuses
# to start unless JWT_SECRET is changed, COOKIE_SECURE=true, and CORS origins are
# https — so a production deploy cannot silently inherit the defaults below.
ENV=development                # development | production
COOKIE_SECURE=false            # true in production — auth cookies need the Secure flag
TRUSTED_PROXY_DEPTH=0          # 0 = direct. Behind a load balancer, set to the number
                               # of proxy hops, or every request looks like it came from
                               # the LB and one user's traffic rate-limits everyone.
METRICS_TOKEN=                 # non-empty enables /internal/metrics behind a token

# ---- AI / RAG (V3) — optional; AI_MODE=off keeps V1/V2 fully working ----
# Vector store runs with: docker compose --profile ai up
AI_MODE=off                    # off | summary_only | full
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=                  # required unless AI_MODE=off (LLM)
JINA_API_KEY=                  # required unless AI_MODE=off (embeddings)
QDRANT_URL=http://qdrant:6333

# ---- Classification routing thresholds ----
CLASSIFICATION_AUTO_THRESHOLD=0.90
CLASSIFICATION_CONFIRM_THRESHOLD=0.70

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Grafana / Observability (infra/docker-compose.obs.yml) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
